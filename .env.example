# Resend API Key
# Get yours at: https://resend.com/api-keys
# Required for contact form email functionality
RESEND_API_KEY=re_your_api_key_here

# Contact form addresses.
# Server-side only: never prefix these with NEXT_PUBLIC_, which would embed
# them in the client bundle at build time.

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Sender address. While this is onboarding@resend.dev, Resend only delivers to
# the account owner's own address; reaching anyone else needs a verified domain.
CONTACT_FROM_EMAIL=